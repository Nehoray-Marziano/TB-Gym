# Browser-visible Supabase project configuration. Use your own project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only. Required for notification delivery; never prefix with NEXT_PUBLIC_.
ONESIGNAL_REST_API_KEY=

# Deployment Git metadata normally supplies this automatically.
# VERCEL_GIT_COMMIT_SHA=
